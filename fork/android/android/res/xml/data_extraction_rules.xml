<?xml version="1.0" encoding="utf-8"?>
<!-- The phone's identity (its TLS key and certificate) and its paired PCs never leave the phone: no cloud backup, no
     transfer to a new phone (security audit fork.12, AS-036). A copy would be recognised by the PC as this phone.
     android:allowBackup="false" stops backup up to Android 11; from Android 12, transfer needs these rules.
     Every domain is excluded: the rest is the window's preferences (theme, language, update notices), set again in
     a few taps. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
