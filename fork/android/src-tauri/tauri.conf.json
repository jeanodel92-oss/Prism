{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Prism",
	"version": "0.1.0",
	"identifier": "space.odelserver.prism.mobile",
	"build": {
		"frontendDist": "../../gui/ui"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [{ "label": "main", "title": "Prism", "backgroundColor": "#050505" }],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self'",
				"img-src": "'self' data:",
				"font-src": "'self'",
				"connect-src": "ipc: http://ipc.localhost",
				"object-src": "'none'",
				"base-uri": "'none'",
				"form-action": "'none'",
				"frame-src": "'none'"
			},
			"freezePrototype": false
		}
	},
	"bundle": {
		"active": true,
		"icon": ["../../gui/src-tauri/icons/icon.png"]
	}
}
