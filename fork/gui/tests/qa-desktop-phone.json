[
	{"do": "log", "text": "fork.12.5: at phone width (412 px), the side menu's buttons that run a command fold the menu, so the screen it opens shows in front of it: the desktop's icon (here: not running) and the trace's button. Profile: {\"extensions\":[\"+builtin:desktop\"],\"interfaceMode\":\"advanced\",\"traceEnabled\":true}"},
	{"do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000},
	{"do": "click", "selector": "#toggle-sidebar"},
	{"do": "wait", "selector": "body.sidebar-open"},
	{"do": "click", "selector": ".rail-button[data-command='desktop']:not([hidden])"},
	{"do": "wait", "selector": "#surface .panel.desktop .panel-text", "text": "not running"},
	{"do": "absent", "selector": "body.sidebar-open", "why": "the panel folds over a narrow window when a command of the side menu opens its screen"},
	{"do": "sleep", "ms": 400, "why": "the overlay slides out"},
	{"do": "in-front", "selector": "#surface .panel.desktop .panel-text", "text": "not running", "why": "the message is not behind the menu"},
	{"do": "fits", "selector": "#surface .panel.desktop"},
	{"do": "shot", "name": "p1-desktop"},
	{"do": "key", "selector": ".panel.desktop", "key": "Escape"},
	{"do": "wait", "selector": "#surface .panel.desktop", "gone": true},
	{"do": "log", "text": "the same for the trace's button (its view shows in the advanced display, with the trace on)"},
	{"do": "click", "selector": "#toggle-sidebar"},
	{"do": "wait", "selector": "body.sidebar-open"},
	{"do": "click", "selector": ".rail-button[data-view='trace']"},
	{"do": "click", "selector": "#side-trace-open"},
	{"do": "wait", "selector": "#surface .panel.inspector-trace"},
	{"do": "absent", "selector": "body.sidebar-open", "why": "the panel folds when the trace's screen opens"},
	{"do": "sleep", "ms": 400, "why": "the overlay slides out"},
	{"do": "in-front", "selector": "#surface .panel.inspector-trace"},
	{"do": "shot", "name": "p2-trace"},
	{"do": "key", "selector": ".panel.inspector-trace", "key": "Escape"},
	{"do": "wait", "selector": "#surface .panel.inspector-trace", "gone": true},
	{"do": "toasts"},
	{"do": "absent", "selector": ".toast.error"},
	{"do": "quit"}
]
