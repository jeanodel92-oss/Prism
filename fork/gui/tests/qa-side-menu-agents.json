[
	{ "do": "log", "text": "fork.11: the sub-agents' icon once the conversation has run one, and each run's full transcript" },
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "absent", "selector": ".rail-button[data-view='agents']", "why": "no agent run yet" },
	{ "do": "type", "text": "calls [[\"agent\",{\"agent\":\"luna\",\"task\":\"steps [[\\\"ls\\\",{\\\"path\\\":\\\".\\\"}],[\\\"read\\\",{\\\"path\\\":\\\"nothing-here.txt\\\"}]]\"}]]" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".tool[data-status='awaiting'] .dialog", "timeout": 30000 },
	{ "do": "sleep", "ms": 500 },
	{ "do": "click", "selector": ".tool[data-status='awaiting'] .dialog button", "text": "Allow once" },
	{ "do": "wait", "selector": ".msg.custom", "text": "luna answered (ag1)", "timeout": 30000 },
	{ "do": "wait", "selector": ".rail-button[data-view='agents']", "timeout": 10000 },
	{ "do": "click", "selector": ".rail-button[data-view='agents']" },
	{ "do": "wait", "selector": "#side-agents-list .agent-run[data-state='answered']", "text": "luna (ag1)" },
	{ "do": "wait", "selector": "#side-agents-list .agent-run .excerpt", "text": "steps" },
	{ "do": "shot", "name": "s1-list" },
	{ "do": "click", "selector": "#side-agents-list .agent-run", "text": "luna (ag1)" },
	{ "do": "wait", "selector": ".panel.agent-transcript .agent-entry.user", "text": "steps" },
	{ "do": "wait", "selector": ".panel.agent-transcript .agent-entry.tool .check-name", "text": "ls" },
	{ "do": "wait", "selector": ".panel.agent-transcript .agent-entry.tool[data-state='error'] .check-name", "text": "read" },
	{ "do": "click", "selector": ".panel.agent-transcript .agent-entry.tool[data-state='error'] summary" },
	{ "do": "wait", "selector": ".panel.agent-transcript .agent-output", "text": "nothing-here.txt" },
	{ "do": "fits", "selector": ".panel.agent-transcript" },
	{ "do": "shot", "name": "s2-transcript" },
	{ "do": "key", "selector": ".panel.agent-transcript", "key": "Escape" },
	{ "do": "wait", "selector": ".panel.agent-transcript", "gone": true },
	{ "do": "toasts" },
