[
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },

	{ "do": "type", "text": "/doctor" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".panel.doctor .check" },
	{ "do": "count", "selector": "#surface > .panel:not(.view-measure)", "count": 1 },
	{ "do": "absent", "selector": ".panel.doctor .view", "why": "the window's own list, not the terminal's report drawn in lines" },
	{ "do": "click", "selector": ".panel.doctor .segmented button", "text": "All" },
	{ "do": "wait", "selector": ".panel.doctor .segmented button[aria-checked='true']", "text": "All" },
	{ "do": "click", "selector": ".panel.doctor .check summary" },
	{ "do": "wait", "selector": ".panel.doctor .check[open] .facts dt", "text": "What to do" },
	{ "do": "fits", "selector": ".panel.doctor .panel-body" },
	{ "do": "apart", "selector": "#toasts .toast", "from": ".panel.doctor" },
	{ "do": "shot", "name": "d1-doctor" },
	{ "do": "click", "selector": ".panel.doctor .panel-actions button", "text": "Export" },
	{ "do": "wait", "selector": ".panel.doctor .panel-actions .field" },
	{ "do": "click", "selector": ".panel.doctor .panel-actions button", "text": "Write" },
	{ "do": "wait", "selector": "#toasts .toast.sticky", "text": "prism-doctor.json" },
	{ "do": "type", "text": "/doctor" },
	{ "do": "send", "why": "typed again while open: the open panel comes back, never a second one" },
	{ "do": "sleep", "ms": 600 },
	{ "do": "count", "selector": "#surface > .panel:not(.view-measure)", "count": 1 },
	{ "do": "key", "selector": ".panel.doctor", "key": "Escape" },
	{ "do": "wait", "selector": ".panel.doctor", "gone": true },
	{ "do": "focused", "selector": "#input" },

	{ "do": "type", "text": "md" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".msg.assistant .md", "timeout": 30000 },
	{ "do": "wait", "selector": ".composer[data-busy='false']", "timeout": 30000 },
	{ "do": "type", "text": "md" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".msg.user ~ .msg.user", "timeout": 30000 },
	{ "do": "wait", "selector": ".msg.assistant ~ .msg.assistant .md", "timeout": 30000 },
	{ "do": "wait", "selector": ".composer[data-busy='false']", "timeout": 30000 },

	{ "do": "type", "text": "/tree" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".panel.tree .tree-row.current" },
	{ "do": "sleep", "ms": 300, "why": "a frame after the panel is shown" },
	{ "do": "in-view", "selector": ".panel.tree .tree-row.current", "why": "the tree opens on the current point" },
	{ "do": "count", "selector": ".panel.tree .tree-row.kind-user", "count": 2 },
	{ "do": "absent", "selector": ".panel.tree .view" },
	{ "do": "focused", "selector": ".panel.tree .listbox-filter" },
	{ "do": "click", "selector": ".panel.tree .tree-row.kind-user ~ .tree-row.kind-user", "why": "the second message: going back to it leaves the first answer with two branches" },
	{ "do": "wait", "selector": ".panel.tree .tree-detail-text", "text": "md" },
	{ "do": "click", "selector": ".panel.tree .panel-actions button", "text": "Label" },
	{ "do": "type", "selector": ".panel.tree .panel-actions .field", "text": "start" },
	{ "do": "key", "selector": ".panel.tree .panel-actions .field", "key": "Enter" },
	{ "do": "wait", "selector": ".panel.tree .tree-row .listbox-meta", "text": "#start" },
	{ "do": "click", "selector": ".panel.tree .segmented button", "text": "Labeled" },
	{ "do": "count", "selector": ".panel.tree .tree-row", "count": 1 },
	{ "do": "click", "selector": ".panel.tree .segmented button", "text": "Messages" },
	{ "do": "click", "selector": ".panel.tree .panel-actions button", "text": "Continue from here" },
	{ "do": "wait", "selector": ".panel.tree li", "text": "No summary" },
	{ "do": "key", "selector": ".panel.tree .listbox", "key": "Escape", "why": "Escape goes back to the tree, as in the terminal" },
	{ "do": "wait", "selector": ".panel.tree .tree-row" },
	{ "do": "dblclick", "selector": ".panel.tree .tree-row.kind-user ~ .tree-row.kind-user", "why": "a double click continues from the entry" },
	{ "do": "click", "selector": ".panel.tree li", "text": "No summary" },
	{ "do": "wait", "selector": "#toasts .toast", "text": "Navigated to selected point" },
	{ "do": "wait", "selector": ".panel.tree", "gone": true },
	{ "do": "wait", "selector": "#input", "text": "md" },
	{ "do": "absent", "selector": ".msg.user ~ .msg.user" },
	{ "do": "send", "why": "the same message again: the conversation now has two branches" },
	{ "do": "wait", "selector": ".msg.user ~ .msg.user", "timeout": 30000 },
	{ "do": "wait", "selector": ".msg.assistant ~ .msg.assistant .md", "timeout": 30000 },
	{ "do": "wait", "selector": ".composer[data-busy='false']", "timeout": 30000 },

	{ "do": "type", "text": "/tree" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".panel.tree .tree-row .listbox-meta", "text": "2 branches" },
	{ "do": "count", "selector": ".panel.tree .tree-row.kind-user", "count": 3 },
	{ "do": "sleep", "ms": 300 },
	{ "do": "in-view", "selector": ".panel.tree .tree-row.current", "why": "the tree opens on the current point, below the fold here" },
	{ "do": "count", "selector": ".panel.tree .tree-row.kind-user.on-path", "count": 2 },
	{ "do": "style", "selector": ".panel.tree .tree-row.kind-user:not(.on-path)", "property": "--indent", "value": "1", "why": "a branch is indented" },
	{ "do": "wait", "selector": ".panel.tree .tree-detail-text.md h2", "text": "Résumé", "why": "an answer is drawn as in the transcript" },
	{ "do": "wait", "selector": ".panel.tree .panel-actions button.primary[disabled]", "text": "Continue from here", "why": "the current point" },
	{ "do": "shot", "name": "t1-tree" },
	{ "do": "type", "selector": ".panel.tree .listbox-filter", "text": "zzzz" },
	{ "do": "wait", "selector": ".panel.tree .listbox-empty" },
	{ "do": "fits", "selector": ".panel.tree .panel-body" },
	{ "do": "apart", "selector": "#toasts .toast", "from": ".panel.tree", "why": "a toast never covers an open panel" },
	{ "do": "shot", "name": "t2-tree-search" },
	{ "do": "key", "selector": ".panel.tree .listbox-filter", "key": "Escape" },
	{ "do": "wait", "selector": ".panel.tree", "gone": true },
	{ "do": "wait", "selector": "#toasts .toast.sticky", "text": "prism-doctor.json", "why": "the path waited above the panel; it shows again once there is room" },
	{ "do": "transcript-clean" },
	{ "do": "log", "text": "qa-inspect-ok" },
	{ "do": "quit" }
]
