[
	{ "do": "log", "text": "Owner's QA of fork.11: /phone, the terminal's way to link a phone, opens the window's own 'Link a phone' panel." },
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "type", "text": "/phone" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".panel.link-phone .link-phone-row button", "timeout": 15000 },
	{ "do": "absent", "selector": ".msg.user", "why": "a window screen, not a message to the model" },
	{ "do": "shot", "name": "phone-command" },
	{ "do": "log", "text": "qa-phone-command-ok" },
	{ "do": "quit" }
]
