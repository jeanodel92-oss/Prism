[
	{ "do": "wait", "selector": "#welcome" },
	{ "do": "shot", "name": "n1-welcome", "settle": 1200 },
	{ "do": "type", "text": "call write {\"path\":\"narrow.txt\",\"content\":\"x\"}" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".tool[data-status='awaiting'] .dialog" },
	{ "do": "wait", "selector": "#welcome:not([hidden])", "gone": true, "timeout": 1000 },
	{ "do": "shot", "name": "n2-permission" },
	{ "do": "sleep", "ms": 500 },
	{ "do": "click", "selector": ".tool[data-status='awaiting'] .dialog button", "text": "Block this action once" },
	{ "do": "wait", "selector": ".composer[data-busy='false']" },
	{ "do": "type", "text": "md" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".msg.assistant .md table" },
	{ "do": "wait", "selector": ".composer[data-busy='false']" },
	{ "do": "shot", "name": "n3-markdown" },
	{ "do": "click", "selector": "#toggle-sidebar" },
	{ "do": "shot", "name": "n4-sidebar-open" },
	{ "do": "click", "selector": "#new-session", "why": "the sidebar's actions work from the overlay", "sidebar": true },
	{ "do": "wait", "selector": "body:not(.sidebar-open)", "why": "opening a session closes the overlay" },
	{ "do": "wait", "selector": "#welcome:not([hidden])" },
	{ "do": "click", "selector": "#toggle-sidebar" },
	{ "do": "click", "selector": "#settings-button", "sidebar": true },
	{ "do": "wait", "selector": "#settings[open]" },
	{ "do": "shot", "name": "n5-settings" },
	{ "do": "click", "selector": "#settings button", "text": "Close" },
