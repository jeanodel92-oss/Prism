	{ "do": "shot", "name": "mcp-fr-list" },
	{ "do": "fits", "selector": ".panel.native-command:not(.closing) .panel-body" },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "fixture" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .native-menu .panel-text", "text": "État : connecté" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "Reconnecter" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "Désactiver" },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "Exposition" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "déclarés au modèle comme les outils intégrés" },
	{ "do": "shot", "name": "mcp-fr-exposure" },
	{ "do": "fits", "selector": ".panel.native-command:not(.closing) .panel-body" },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .native-menu-back" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "Outils" },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "Outils" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .native-menu .panel-text", "text": "Exposition codemode : appelés depuis les scripts codemode" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "echo" },
	{ "do": "shot", "name": "mcp-fr-tools" },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .panel-close" },
