	{ "do": "send" },
	{ "do": "wait", "selector": "#widgets .widget.session-state", "gone": true, "why": "the next prompt: the state no longer applies" },
	{ "do": "wait", "selector": ".composer[data-busy='false']", "timeout": 30000 },
	{ "do": "absent", "selector": "#widgets .widget" },
	{ "do": "log", "text": "session-state-ok" },
	{ "do": "quit" }
]
