[
	{ "do": "log", "text": "QG-04: the state of a session whose last turn was cut short, as the window's card, not the terminal widget's lines" },
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "type", "text": "slow" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".thinking" },
	{ "do": "click", "selector": "#send", "text": "Stop" },
	{ "do": "wait", "selector": ".msg-error.aborted", "timeout": 5000 },
	{ "do": "wait", "selector": ".composer[data-busy='false']" },
	{ "do": "absent", "selector": "#widgets .widget", "why": "an interruption in this window: the transcript already says it" },
	{ "do": "type", "text": "/reload" },
	{ "do": "send" },
	{ "do": "wait", "selector": "#widgets .widget.session-state .facts", "text": "Interrupted", "why": "/reload starts the session again: its session_start" },
	{ "do": "absent", "selector": "#widgets pre.widget[data-key='session-state']" },
	{ "do": "fits", "selector": "#widgets .widget.session-state" },
	{ "do": "contrast", "selector": "#widgets .widget.session-state", "text": "Interrupted" },
	{ "do": "shot", "name": "ss1-reloaded" },
	{ "do": "click", "selector": "#new-session", "sidebar": true },
	{ "do": "wait", "selector": "#welcome" },
	{ "do": "absent", "selector": "#widgets .widget.session-state", "why": "another conversation" },
	{ "do": "click", "selector": "#open-list li:not(.current) .close", "sidebar": true },
	{ "do": "wait", "selector": "#history-list .session-link", "sidebar": true },
	{ "do": "click", "selector": "#history-list .session-link", "sidebar": true },
	{ "do": "wait", "selector": "#widgets .widget.session-state .facts", "text": "Interrupted", "timeout": 30000, "why": "opened from the history: a new engine, whose session_start comes before the window shows views" },
	{ "do": "absent", "selector": "#widgets pre.widget[data-key='session-state']" },
	{ "do": "shot", "name": "ss2-resumed" },
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000, "why": "the transcript shows before its engine is ready (session_preview); Enter waits for it" },
