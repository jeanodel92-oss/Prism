[
	{ "do": "wait", "selector": "#welcome" },
	{ "do": "shot", "name": "01-welcome-dark", "settle": 1500 },

	{ "do": "type", "text": "md" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".msg.assistant .md" },
	{ "do": "wait", "selector": ".composer[data-busy='false']" },
	{ "do": "shot", "name": "02-markdown-dark" },

	{ "do": "type", "text": "call write {\"path\":\"denied.txt\",\"content\":\"no\"}" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".tool[data-status='awaiting'] .dialog" },
	{ "do": "shot", "name": "03-permission-question" },
	{ "do": "sleep", "ms": 500 },
	{ "do": "click", "selector": ".tool[data-status='awaiting'] .dialog button", "text": "Block this action once" },
	{ "do": "wait", "selector": ".tool[data-status='error']" },
	{ "do": "wait", "selector": ".composer[data-busy='false']" },
	{ "do": "shot", "name": "04-permission-denied" },

	{ "do": "type", "text": "call write {\"path\":\"allowed.txt\",\"content\":\"yes\"}" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".tool[data-status='awaiting'] .dialog" },
	{ "do": "sleep", "ms": 500 },
	{ "do": "click", "selector": ".tool[data-status='awaiting'] .dialog button", "text": "Allow once" },
	{ "do": "wait", "selector": ".tool[data-status='done'] .tool-target", "text": "allowed.txt" },
	{ "do": "wait", "selector": ".composer[data-busy='false']" },

	{ "do": "type", "text": "call write {\"path\":\"interrupted.txt\",\"content\":\"no\"}" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".tool[data-status='awaiting'] .dialog" },
	{ "do": "key", "selector": "body", "key": "Escape" },
	{ "do": "wait", "selector": ".tool .tool-state", "text": "interruption" },
	{ "do": "wait", "selector": ".composer[data-busy='false']" },
	{ "do": "shot", "name": "05-permission-interrupted" },

	{ "do": "type", "text": "slow" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".thinking" },
	{ "do": "sleep", "ms": 1200 },
	{ "do": "shot", "name": "06-streaming" , "settle": 0 },
	{ "do": "click", "selector": "#send", "text": "Stop" },
	{ "do": "log", "text": "the fake provider stops at once since 2026-10-30, so the short \"Stopping\" label is no longer waited for" },
	{ "do": "wait", "selector": ".msg-error.aborted", "timeout": 5000 },
	{ "do": "wait", "selector": ".composer[data-busy='false']" },
	{ "do": "shot", "name": "07-interrupted" },

	{ "do": "pref", "id": "pref-theme", "value": "light" },
	{ "do": "shot", "name": "08-light" },
	{ "do": "pref", "id": "pref-language", "value": "fr" },
	{ "do": "click", "selector": "#settings-button", "sidebar": true },
	{ "do": "shot", "name": "09-settings-fr-light" },
	{ "do": "click", "selector": "#settings button", "text": "Fermer" },
	{ "do": "pref", "id": "pref-theme", "value": "dark" },

	{ "do": "pref", "id": "pref-language", "value": "system" },

	{ "do": "click", "selector": "#new-session", "sidebar": true },
	{ "do": "wait", "selector": "#welcome" },
	{ "do": "click", "selector": "#open-list li:not(.current) .close", "sidebar": true },
	{ "do": "wait", "selector": "#history-list .session-link", "sidebar": true },
	{ "do": "shot", "name": "11-second-session" },
	{ "do": "click", "selector": "#history-list .session-link", "sidebar": true },
	{ "do": "wait", "selector": ".tool .tool-target", "text": "allowed.txt" },
	{ "do": "shot", "name": "12-resumed-from-history" },

	{ "do": "metrics", "label": "before-bench" },
	{ "do": "type", "text": "bench" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".composer[data-busy='true']" },
	{ "do": "wait", "selector": ".composer[data-busy='false']", "timeout": 180000 },
	{ "do": "metrics", "label": "bench" },
	{ "do": "shot", "name": "13-after-bench" },
	{ "do": "quit" }
]
