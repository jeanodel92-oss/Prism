	},
	{
		"do": "wait",
		"selector": ".queue-tray",
		"gone": true
	},
	{
		"do": "wait",
		"selector": "#input",
		"text": "use the other file instead"
	},
	{
		"do": "wait",
		"selector": "#input",
		"text": "then write the tests"
