	},
	{
		"do": "type",
		"text": "then write the tests"
	},
	{
		"do": "key",
		"selector": "#input",
		"key": "Enter",
		"mods": {
			"altKey": true
		},
		"why": "app.message.followUp (alt+enter)"
	},
	{
		"do": "wait",
		"selector": ".queue-tray .queue-item[data-kind='followUp'] .queue-text",
		"text": "then write the tests"
	},
	{
		"do": "wait",
		"selector": ".queue-tray .queue-title",
