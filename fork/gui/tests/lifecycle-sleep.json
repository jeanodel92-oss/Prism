[
	{ "do": "log", "text": "Engine lifecycle: blank conversations reused, idle ones asleep, woken on open. scripts/lifecycle.py counts the engine processes at each 'measure' line." },
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "click", "selector": "#new-session" },
	{ "do": "click", "selector": "#new-session" },
	{ "do": "click", "selector": "#new-session" },
	{ "do": "count", "selector": "#open-list li", "count": 1, "why": "an empty conversation is reused, not started again" },
	{ "do": "awake", "awake": 1, "asleep": 0 },
	{ "do": "log", "text": "measure blank-reused" },
	{ "do": "sleep", "ms": 9000 },
	{ "do": "open-sessions", "count": 6 },
	{ "do": "awake", "awake": 6, "asleep": 0 },
	{ "do": "log", "text": "measure 6-open" },
	{ "do": "grant", "index": 0, "host": "kept-while-asleep.invalid" },
	{ "do": "sleep", "ms": 9000 },
	{ "do": "idle-ms", "ms": 0 },
	{ "do": "reclaim" },
	{ "do": "awake", "awake": 1, "asleep": 5, "why": "only the conversation on screen keeps its engine" },
	{ "do": "log", "text": "measure 5-asleep" },
	{ "do": "sleep", "ms": 9000 },
	{ "do": "open-nth", "index": 0 },
	{ "do": "awake", "awake": 2, "asleep": 4 },
	{ "do": "granted", "index": 0, "host": "kept-while-asleep.invalid", "why": "what was allowed in this session survives the sleep" },
	{ "do": "absent", "selector": "#banner:not([hidden])", "why": "a conversation put to sleep is not an engine that stopped" },
	{ "do": "open-nth", "index": 3 },
	{ "do": "open-nth", "index": 1 },
	{ "do": "open-nth", "index": 4 },
	{ "do": "reclaim" },
	{ "do": "awake", "awake": 1, "asleep": 5 },
	{ "do": "close-sessions", "keep": 2 },
	{ "do": "open-nth", "index": 0 },
	{ "do": "open-nth", "index": 1 },
	{ "do": "absent", "selector": "#banner:not([hidden])" },
	{ "do": "reclaim" },
	{ "do": "awake", "awake": 1, "asleep": 1 },
	{ "do": "log", "text": "measure after-switches" },
	{ "do": "sleep", "ms": 9000 },
	{ "do": "log", "text": "lifecycle-ok" },
	{ "do": "quit" }
]
