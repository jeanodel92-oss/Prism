[
	{ "do": "log", "text": "fork.11: scheduled tasks and memory when their module is on, the trace and the logs in the advanced display" },
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "wait", "selector": ".rail-button[data-view='schedule']" },
	{ "do": "wait", "selector": ".rail-button[data-view='memory']" },
	{ "do": "wait", "selector": ".rail-button[data-view='trace']" },
	{ "do": "wait", "selector": ".rail-button[data-view='logs']" },
	{ "do": "absent", "selector": ".rail-button[data-command='desktop']:not([hidden])", "why": "the agent's desktop module is off here: no /desktop icon" },

	{ "do": "click", "selector": ".rail-button[data-view='schedule']" },
	{ "do": "wait", "selector": "#side-schedule-list li.warning", "text": "cannot schedule tasks", "why": "the drive runs Prism from its sources: the engine refuses to schedule, the view says why" },
	{ "do": "wait", "selector": "#side-schedule-new:disabled" },
	{ "do": "shot", "name": "s1-schedule" },

	{ "do": "click", "selector": ".rail-button[data-view='memory']" },
	{ "do": "wait", "selector": "#side-memory .side-text", "text": "Prefers short answers" },
	{ "do": "fits", "selector": ".side-panel" },
	{ "do": "shot", "name": "s2-memory" },
	{ "do": "click", "selector": "#side-memory button", "text": "Update from this conversation" },
	{ "do": "wait", "selector": "#input", "text": "/memory" },
	{ "do": "focused", "selector": "#input" },
	{ "do": "type", "text": "" },

	{ "do": "click", "selector": ".rail-button[data-view='logs']" },
	{ "do": "wait", "selector": "#side-logs-output", "text": "drive: engine output line", "why": "owner, 2026-11-12: the logs are the engine's technical output, the trace has its own icon" },
	{ "do": "wait", "selector": "#side-logs-output", "text": "Authorization: Bearer •••" },
	{ "do": "absent", "selector": "#side-logs-output", "text": "drive-secret-token" },
	{ "do": "fits", "selector": ".side-panel" },
	{ "do": "shot", "name": "s3-logs" },

	{ "do": "click", "selector": ".rail-button[data-view='trace']" },
	{ "do": "wait", "selector": "#side-trace-list li.muted", "text": "No operation traced yet" },
	{ "do": "type", "text": "call write {\"path\":\"denied.txt\",\"content\":\"side menu\"}" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".tool[data-status='awaiting'] .dialog button", "text": "Block this action once", "timeout": 30000 },
	{ "do": "sleep", "ms": 500, "why": "the permission dialog deliberately ignores clicks during its opening guard" },
	{ "do": "click", "selector": ".tool[data-status='awaiting'] .dialog button", "text": "Block this action once" },
	{ "do": "wait", "selector": ".msg.assistant + .turn-summary", "timeout": 30000 },
	{ "do": "wait", "selector": "#side-trace-list .session-link.log[data-state='denied']", "text": "write", "timeout": 10000 },
	{ "do": "shot", "name": "s4-trace" },
	{ "do": "click", "selector": "#side-trace-list .session-link.log[data-state='denied']" },
	{ "do": "wait", "selector": ".panel.inspector-trace details[data-state='denied']" },
	{ "do": "key", "selector": ".panel.inspector", "key": "Escape" },
	{ "do": "wait", "selector": ".panel.inspector", "gone": true },

	{ "do": "click", "selector": ".rail-button[data-view='logs']" },
	{ "do": "wait", "selector": "#side-logs-output", "text": "reply from", "why": "owner's QA, 2026-11-13: the logs say what went well too, each reply with its tokens and time" },
	{ "do": "wait", "selector": "#side-logs-output", "text": "tool write failed" },
	{ "do": "wait", "selector": "#side-logs-output", "text": "idle" },
	{ "do": "shot", "name": "s5-logs-turn" },

	{ "do": "toasts" },
	{ "do": "absent", "selector": ".toast.error" },
	{ "do": "quit" }
]
