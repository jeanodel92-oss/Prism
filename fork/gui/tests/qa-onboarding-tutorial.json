[
	{ "do": "log", "text": "QG-04: the onboarding's « Start the tutorial » opens the window's tutorial, not the terminal's view" },
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "type", "text": "/onboarding" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .panel-title", "text": "Language", "timeout": 15000 },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "English" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .panel-title", "text": "Theme" },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "Automatic" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .panel-title", "text": "Display" },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "Simple" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .panel-title", "text": "Permissions" },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "Ask" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .panel-title", "text": "Optional modules" },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .native-menu-action", "text": "Continue" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .panel-title", "text": "Model" },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "Keep this model" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .panel-title", "text": "Tutorial" },
	{ "do": "click", "selector": ".panel.native-command:not(.closing) .listbox li", "text": "Start the tutorial" },
	{ "do": "wait", "selector": "#surface .panel.tutorial .tutorial-title", "timeout": 15000, "why": "the window's tutorial" },
	{ "do": "wait", "selector": ".panel.native-command", "gone": true },
	{ "do": "count", "selector": ".panel.tutorial .listbox li", "count": 9 },
	{ "do": "absent", "selector": ".view .view-lines" },
	{ "do": "absent", "selector": "#toasts .toast.error" },
	{ "do": "shot", "name": "ot1-tutorial" },
	{ "do": "log", "text": "onboarding-tutorial-ok" },
	{ "do": "quit" }
]
