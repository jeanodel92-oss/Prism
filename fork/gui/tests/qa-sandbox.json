[
	{ "do": "log", "text": "QA 2026-11-01: /sandbox is configurable from the window's own screen." },
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "type", "text": "/sandbox" },
	{ "do": "send" },
	{ "do": "wait", "selector": "#surface .panel.sandbox .sandbox-status" },
	{ "do": "count", "selector": ".panel.sandbox > .panel-body > .segmented button", "count": 4 },
	{ "do": "shot", "name": "s1-modes" },
	{ "do": "wait", "selector": ".panel.sandbox [data-field='modes.broad'] input" },
	{ "do": "click", "selector": ".panel.sandbox > .panel-body > .segmented button", "text": "Network" },
	{ "do": "wait", "selector": ".panel.sandbox [data-field='network.allow'] form" },
	{ "do": "type", "selector": ".panel.sandbox [data-field='network.allow'] form input", "text": "example.org" },
	{ "do": "click", "selector": ".panel.sandbox [data-field='network.allow'] form button" },
	{ "do": "wait", "selector": ".panel.sandbox [data-field='network.allow'] li code", "text": "example.org", "why": "saved by the engine and drawn from its answer" },
	{ "do": "shot", "name": "s2-network" },
	{ "do": "click", "selector": ".panel.sandbox [data-field='network.allow'] li button" },
	{ "do": "wait", "selector": ".panel.sandbox [data-field='network.allow'] li", "gone": true },
	{ "do": "click", "selector": ".panel.sandbox > .panel-body > .segmented button", "text": "Files" },
	{ "do": "wait", "selector": ".panel.sandbox [data-field='read.allow'] select", "why": "where a readable path applies" },
	{ "do": "type", "selector": ".panel.sandbox [data-field='read.allow'] form input", "text": "/no/such/prism/path" },
	{ "do": "click", "selector": ".panel.sandbox [data-field='read.allow'] form button" },
	{ "do": "wait", "selector": "#toasts .toast", "why": "a path refused says why" },
	{ "do": "sleep", "ms": 100 },
	{ "do": "shot", "name": "s3-files" },
	{ "do": "click", "selector": ".panel.sandbox [data-field='read.limit'] .segmented button", "text": "all" },
	{ "do": "wait", "selector": ".panel.sandbox [data-field='read.allow']", "gone": true },
	{ "do": "click", "selector": ".panel.sandbox [data-field='read.limit'] .segmented button", "text": "project" },
	{ "do": "wait", "selector": ".panel.sandbox [data-field='read.allow'] select" },
	{ "do": "key", "selector": ".panel.sandbox", "key": "Escape" },
	{ "do": "wait", "selector": "#surface .panel.sandbox", "gone": true },
	{ "do": "log", "text": "qa-sandbox-ok" },
	{ "do": "quit" }
]
