[
	{"do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000},
	{"do": "type", "text": "! printf '%s\\n' '{\"type\":\"session\",\"version\":3,\"id\":\"imp1\",\"timestamp\":\"2026-10-30T10:00:00.000Z\",\"cwd\":\"/nonexistent-prism\"}' '{\"type\":\"message\",\"id\":\"m1\",\"parentId\":null,\"timestamp\":\"2026-10-30T10:00:01.000Z\",\"message\":{\"role\":\"user\",\"content\":\"imported hello\",\"timestamp\":1}}' > old.jsonl"},
	{"do": "send"},
	{"do": "wait", "selector": ".composer[data-busy='false']", "timeout": 15000},
	{"do": "type", "text": "/import old.jsonl"},
	{"do": "send"},
	{"do": "wait", "selector": ".panel.question", "text": "old.jsonl"},
	{"do": "sleep", "ms": 500, "why": "a question ignores clicks for 400 ms after it appears (arming)"},
	{"do": "click", "selector": ".panel.question :is(li, button)", "text": "No"},
	{"do": "wait", "selector": "#toasts .toast", "text": "Import cancelled"},
	{"do": "absent", "selector": ".msg.user", "text": "imported hello"},
	{"do": "type", "text": "/import \"old.jsonl\""},
	{"do": "send"},
	{"do": "wait", "selector": ".panel.question :is(li, button)", "text": "Yes"},
	{"do": "sleep", "ms": 500},
	{"do": "click", "selector": ".panel.question :is(li, button)", "text": "Yes"},
	{"do": "wait", "selector": ".panel.question", "text": "/nonexistent-prism", "why": "the session's folder is missing: the terminal's second question"},
	{"do": "sleep", "ms": 500},
	{"do": "click", "selector": ".panel.question :is(li, button)", "text": "Yes"},
	{"do": "wait", "selector": ".msg.user", "text": "imported hello"},
	{"do": "wait", "selector": "#toasts .toast", "text": "Session imported from: old.jsonl"},
	{"do": "shot", "name": "i1-imported"},
	{"do": "log", "text": "import-ok"},
	{"do": "quit"}
]
