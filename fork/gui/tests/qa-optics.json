[
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "pref", "id": "pref-theme", "value": "dark" },
	{ "do": "pref", "id": "pref-animations", "value": "on" },
	{ "do": "sleep", "ms": 1000 },
	{ "do": "scene-pixels", "phase": 1 },
	{ "do": "style", "selector": "#scene", "property": "filter", "value": "blur(0px)", "why": "the vector eclipse is sharp at the welcome, as the prism" },
	{ "do": "shot", "name": "eclipse" },
	{ "do": "pointer", "x": 0.95, "y": 0.9 },
	{ "do": "parallax", "x": 0.9, "y": 0.8, "ms": 1500, "shots": "eclipse-pointer" },
	{ "do": "scene-pixels", "phase": 4 },
	{ "do": "style", "selector": "#scene", "property": "filter", "value": "blur(0px)", "why": "the vector prism is sharp at the welcome" },
	{ "do": "shot", "name": "prism" },
	{ "do": "pointer", "x": 0.05, "y": 0.1 },
	{ "do": "parallax", "x": -0.9, "y": -0.8, "ms": 1500, "shots": "prism-pointer" },
	{ "do": "pref", "id": "pref-animations", "value": "off" },
	{ "do": "scene-trace", "ms": 600 },
	{ "do": "sleep", "ms": 700 },
	{ "do": "scene-check", "running": false, "why": "reduced motion: the prism is drawn once and stands still" },
	{ "do": "shot", "name": "prism-still" },
	{ "do": "type", "text": "md" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".msg.assistant" },
	{ "do": "wait", "selector": "#composer[data-busy='false']", "timeout": 30000 },
	{ "do": "sleep", "ms": 10000 },
	{ "do": "shot", "name": "messages" },
	{ "do": "pref", "id": "pref-theme", "value": "light" },
	{ "do": "style", "selector": ".stage", "property": "background-color", "value": "rgba(0, 0, 0, 0)" },
	{ "do": "quit" }
]
