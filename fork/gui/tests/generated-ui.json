[
	{"do": "log", "text": "Generated UI (show_ui): streamed preview, the engine's validated document, answers through ui_submit. Run with FAKE_PLAIN=1."},
	{"do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000},
	{"do": "type", "text": "stream-call show_ui {\"title\":\"Plans\",\"blocks\":[{\"type\":\"table\",\"title\":\"Prices\",\"columns\":[\"Plan\",\"Seats\",\"Note\"],\"rows\":[[\"Free\",1,\"<img src=x onerror=alert(1)>\"],[\"Pro\",10,\"[link](https://example.test)\"]]},{\"type\":\"chart\",\"title\":\"Load\",\"kind\":\"bar\",\"labels\":[\"Mon\",\"Tue\",\"Wed\"],\"series\":[{\"name\":\"CPU\",\"values\":[20,45,30]},{\"name\":\"IO\",\"values\":[5,12,8]}],\"unit\":\"%\"},{\"type\":\"facts\",\"items\":[{\"label\":\"Region\",\"value\":\"EU\"}]},{\"type\":\"choices\",\"title\":\"Which plan?\",\"options\":[{\"label\":\"Free\"},{\"label\":\"Pro\",\"reply\":\"/help\"}]}]}"},
	{"do": "send"},
	{"do": "wait", "selector": ".tool.preview .gen-ui [data-type='table']", "why": "the preview of the partial arguments, while the model writes them"},
	{"do": "absent", "selector": ".tool.preview .gen-choices button:not([disabled])", "why": "a preview cannot be answered"},
	{"do": "wait", "selector": ".tool[data-status='done'] .gen-choices", "timeout": 30000},
	{"do": "wait", "selector": ".composer[data-busy='false']", "timeout": 30000},
	{"do": "wait", "selector": "[data-type='table'] td", "text": "<img src=x onerror=alert(1)>", "why": "the model's markup is text"},
	{"do": "absent", "selector": ".gen-ui img, .gen-ui a"},
	{"do": "wait", "selector": "[data-type='chart'] svg rect.series.s1"},
	{"do": "wait", "selector": ".gen-legend", "text": "IO"},
	{"do": "wait", "selector": "[data-type='table'] td.num", "text": "10"},
	{"do": "wait", "selector": ".tool .tool-target", "text": "Plans", "why": "the call line shows the title, as the terminal's"},
	{"do": "shot", "name": "dark"},
	{"do": "fits", "selector": ".tool .gen-ui", "why": "a wide table scrolls inside its own box; the card is not cut"},
	{"do": "fits", "selector": "#scroller"},
	{"do": "contrast", "selector": "[data-type='table']", "text": "Free", "min": 4.5},
	{"do": "click", "selector": ".gen-choices button:nth-child(2)"},
	{"do": "wait", "selector": ".msg.user .bubble", "text": "Answer to “Which plan?”: /help", "timeout": 30000, "why": "a reply that looks like a command is a plain message"},
	{"do": "absent", "selector": ".view-lines", "why": "/help did not run"},
	{"do": "wait", "selector": ".composer[data-busy='false']", "timeout": 30000},
	{"do": "wait", "selector": ".gen-choices button[disabled]", "why": "answered: closed"},
	{"do": "type", "text": "call show_ui {\"blocks\":[{\"type\":\"chart\",\"labels\":[\"a\",\"b\"],\"series\":[{\"name\":\"s\",\"values\":[1]}]}]}"},
	{"do": "send"},
	{"do": "wait", "selector": ".tool[data-status='error'] .tool-output", "text": "Invalid UI document", "timeout": 30000},
	{"do": "wait", "selector": ".composer[data-busy='false']", "timeout": 30000},
	{"do": "type", "text": "call show_ui {\"blocks\":[{\"type\":\"form\",\"title\":\"Details\",\"fields\":[{\"label\":\"Name\",\"required\":true},{\"label\":\"Seats\",\"kind\":\"number\"},{\"label\":\"Region\",\"kind\":\"select\",\"options\":[\"EU\",\"US\"]},{\"label\":\"Invoice\",\"kind\":\"toggle\"}],\"submit\":\"Send details\"}]}"},
	{"do": "send"},
	{"do": "wait", "selector": ".gen-form button[type='submit']:not([disabled])", "timeout": 30000},
	{"do": "wait", "selector": ".composer[data-busy='false']", "timeout": 30000},
	{"do": "click", "selector": ".gen-form button[type='submit']", "why": "Name is required: the window keeps the form"},
	{"do": "absent", "selector": ".msg.user .bubble", "text": "Name:"},
	{"do": "type", "selector": ".gen-form label:nth-child(1) input", "text": "Ada"},
	{"do": "type", "selector": ".gen-form label:nth-child(2) input", "text": "3"},
	{"do": "type", "selector": ".gen-form label:nth-child(3) select", "text": "US"},
	{"do": "click", "selector": ".gen-form label:nth-child(4) input"},
	{"do": "shot", "name": "form"},
	{"do": "click", "selector": ".gen-form button[type='submit']"},
	{"do": "wait", "selector": ".msg.user .bubble", "text": "- Region: US", "timeout": 30000},
	{"do": "wait", "selector": ".msg.user .bubble", "text": "- Invoice: yes"},
	{"do": "wait", "selector": ".composer[data-busy='false']", "timeout": 30000},
	{"do": "type", "text": "call show_ui {\"blocks\":[{\"type\":\"chart\",\"kind\":\"line\",\"labels\":[\"a\",\"b\",\"c\",\"d\"],\"series\":[{\"name\":\"x\",\"values\":[1,-2,3,0.5]}]}]}"},
	{"do": "send"},
	{"do": "wait", "selector": "[data-type='chart'] svg polyline.series", "timeout": 30000},
	{"do": "wait", "selector": ".composer[data-busy='false']", "timeout": 30000},
	{"do": "pref", "id": "pref-theme", "value": "light"},
	{"do": "wait", "selector": "html[data-appearance='light']"},
	{"do": "scroll-to", "top": 0, "settle": 500, "why": "the table is in the first reply: back to it, since only the entries around the view are in the page (transcript-list.js)"},
	{"do": "contrast", "selector": "[data-type='table']", "text": "Free", "min": 4.5},
	{"do": "shot", "name": "light"},
	{"do": "pref", "id": "pref-theme", "value": "system"},
	{"do": "log", "text": "generated-ui-ok"},
	{"do": "quit"}
]
