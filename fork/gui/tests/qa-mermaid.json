[
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "type", "text": "mermaid" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".msg.assistant figure.diagram img", "timeout": 20000, "why": "the Mermaid setting (streaming by default) draws the diagram in the window, as the terminal draws it" },
	{ "do": "wait", "selector": ".msg.assistant .text p", "text": "dernière phrase" },
	{ "do": "absent", "selector": ".msg.assistant figure.code .lang", "text": "mermaid" },
	{ "do": "shot", "name": "display-diagram" },
	{ "do": "click", "selector": "#settings-button", "sidebar": true },
	{ "do": "click", "selector": "#settings .settings-section", "text": "Appearance" },
	{ "do": "absent", "selector": "#settings-engine [data-item$=':quiet-startup']", "why": "the terminal's startup print: nothing to apply in the window" },
	{ "do": "pref", "selector": "#settings-engine .native-menu select[data-item$=':mermaid-rendering']", "value": "off" },
	{ "do": "wait", "selector": ".msg.assistant figure.code .lang", "text": "mermaid", "why": "off shows the source again, at once" },
	{ "do": "absent", "selector": ".msg.assistant figure.diagram" },
	{ "do": "pref", "selector": "#settings-engine .native-menu select[data-item$=':mermaid-rendering']", "value": "final" },
	{ "do": "wait", "selector": ".msg.assistant figure.diagram img", "why": "the reply is complete: final draws it" },
	{ "do": "click", "selector": "#settings .settings-section", "text": "Window" },
	{ "do": "pref", "id": "pref-theme", "value": "light" },
	{ "do": "wait", "selector": "html[data-appearance='light']" },
	{ "do": "wait", "selector": ".msg.assistant figure.diagram img", "why": "drawn again in the light appearance's colours" },
	{ "do": "click", "selector": "#settings button", "text": "Close" },
	{ "do": "wait", "selector": "#settings[open]", "gone": true },
	{ "do": "sleep", "ms": 800 },
	{ "do": "shot", "name": "display-diagram-light" },
	{ "do": "quit" }
]
