[
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "edit", "text": "hello world", "why": "typed through the web view's own editing, which keeps the undo history" },
	{ "do": "wait", "selector": "#input", "text": "hello world" },
