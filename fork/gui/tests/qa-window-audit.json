[
	{ "do": "log", "text": "Audit of the public release, 2026-11-23: focus, zoom, notices, unknown commands, Tab, the settings' Escape." },
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "focused", "selector": "#input", "timeout": 3000, "why": "UX-01: the composer has the keyboard when the window opens" },

	{ "do": "wait", "selector": "#toasts .toast", "text": "read only the project", "why": "the read-limit notice of a new profile" },
	{ "do": "apart", "selector": "#toasts .toast", "from": "#composer" },
	{ "do": "shot", "name": "a1-welcome-notice", "settle": 800 },
	{ "do": "click", "selector": "#toasts .toast .toast-close", "why": "FIN-19: every notice can be closed" },
	{ "do": "absent", "selector": "#toasts .toast", "text": "read only the project" },
	{ "do": "focused", "selector": "#input", "why": "UX-01: a notice closed leaves the keyboard in the composer" },

	{ "do": "type", "text": "/zzz" },
	{ "do": "send" },
	{ "do": "wait", "selector": "#toasts .toast.warning", "text": "Unknown command /zzz", "why": "UX-10, FIN-27: a typo is not a terminal command" },
	{ "do": "absent", "selector": "#toasts .toast", "text": "/zzz is available in the terminal only" },
	{ "do": "type", "text": "/modle" },
	{ "do": "send" },
	{ "do": "wait", "selector": "#toasts .toast.warning", "text": "Did you mean /model?" },
	{ "do": "type", "text": "/llama" },
	{ "do": "send" },
	{ "do": "wait", "selector": "#toasts .toast.warning", "text": "/llama is available in the terminal only", "why": "a real terminal-only command keeps its message" },
	{ "do": "shot", "name": "a2-unknown-command" },

	{ "do": "type", "text": "zqxj" },
	{ "do": "focus", "selector": "#input" },
	{ "do": "key", "selector": "#input", "key": "Tab", "why": "UX-13: Tab in a draft with nothing to complete moves the keyboard on" },
	{ "do": "focused", "selector": "#attach-button" },
	{ "do": "wait", "selector": "html[data-keyboard] #attach-button", "why": "UX-14: Tab marks the keyboard in use, for the focus ring (style.css). The ring itself needs the window in front, which a headless bench is not (:focus does not match there): checked by hand" },
	{ "do": "shot", "name": "a3-tab-ring" },
	{ "do": "type", "text": "" },

	{ "do": "click", "selector": "#settings-button" },
	{ "do": "wait", "selector": "#settings[open]" },
	{ "do": "focused", "selector": "#settings .settings-section[aria-current='true']", "why": "UX-12: the keyboard starts in the dialog" },
	{ "do": "key", "key": "Escape" },
	{ "do": "wait", "selector": "#settings[open]", "gone": true, "timeout": 2000, "why": "UX-12: Escape closes Settings right after it opened" },
	{ "do": "focused", "selector": "#input", "why": "UX-01: and the keyboard is back in the composer" },
	{ "do": "click", "selector": "#settings-button" },
	{ "do": "wait", "selector": "#settings[open]" },
	{ "do": "key", "selector": "body", "key": "Escape" },
	{ "do": "wait", "selector": "#settings[open]", "gone": true, "timeout": 2000, "why": "UX-12: also with the keyboard in none of its controls" },

	{ "do": "viewport", "mark": "zoom-100" },
	{ "do": "key", "selector": "#input", "key": "=", "mods": { "ctrlKey": true }, "why": "UX-03: Ctrl+= zooms in" },
	{ "do": "viewport", "sameAs": "zoom-100", "scale": 1.1 },
	{ "do": "key", "selector": "#input", "key": "+", "mods": { "ctrlKey": true, "shiftKey": true }, "why": "Ctrl+Shift+= (and the keypad's +) type +" },
	{ "do": "viewport", "sameAs": "zoom-100", "scale": 1.25 },
	{ "do": "shot", "name": "a4-zoom-125" },
	{ "do": "click", "selector": "#settings-button" },
	{ "do": "wait", "selector": "#settings #pref-zoom", "text": "1.25", "why": "Settings › Window › Text size follows the keys" },
	{ "do": "wait", "selector": "#settings #info-version-label", "text": "Prism version", "why": "FIN-29: the product's version, not the window's" },
	{ "do": "key", "selector": "#settings #pref-zoom", "key": "-", "mods": { "ctrlKey": true }, "why": "the zoom keys work in Settings too" },
	{ "do": "viewport", "sameAs": "zoom-100", "scale": 1.1 },
	{ "do": "pref", "id": "pref-zoom", "value": "1.5" },
	{ "do": "viewport", "sameAs": "zoom-100", "scale": 1.5 },
	{ "do": "key", "selector": "#settings #pref-zoom", "key": "0", "mods": { "ctrlKey": true } },
	{ "do": "viewport", "sameAs": "zoom-100" },
	{ "do": "click", "selector": "#settings .dialog-actions button" },
	{ "do": "wait", "selector": "#settings[open]", "gone": true },
	{ "do": "focused", "selector": "#input", "why": "UX-01: closed by its button, the keyboard goes back to the composer" },
	{ "do": "quit" }
]
