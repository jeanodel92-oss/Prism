[
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },

	{ "do": "type", "text": "md" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".msg.assistant .md", "timeout": 30000 },
	{ "do": "wait", "selector": ".composer[data-busy='false']", "timeout": 30000 },

	{ "do": "focus", "selector": "#input" },
	{ "do": "key", "selector": "#input", "key": "ArrowUp", "why": "the editor's history: the last message sent" },
	{ "do": "wait", "selector": "#input", "text": "md" },
	{ "do": "key", "selector": "#input", "key": "ArrowDown", "why": "back to the (empty) draft" },
	{ "do": "absent", "selector": "#input", "text": "md" },

	{ "do": "type", "text": "/hotkeys" },
	{ "do": "send" },
	{ "do": "wait", "selector": "#toasts .toast", "why": "QG-56: /hotkeys is withdrawn; typed, it is not sent to the model" },
	{ "do": "absent", "selector": ".panel.report .keys-table" },
	{ "do": "absent", "selector": ".msg.user", "text": "/hotkeys" },

	{ "do": "type", "text": "/expand" },
	{ "do": "send" },
	{ "do": "wait", "selector": "#toasts .toast", "text": "Thinking and tool output: expanded" },
	{ "do": "type", "text": "/expand" },
	{ "do": "send" },
	{ "do": "wait", "selector": "#toasts .toast", "text": "Thinking and tool output: collapsed" },

	{ "do": "type", "text": "/help" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".panel.help .panel-title", "text": "Help" },
	{ "do": "focused", "selector": ".panel.help .listbox-filter" },
	{ "do": "absent", "selector": ".panel.terminal-view", "why": "the window's own list, not the terminal's help drawn in a grid" },
	{ "do": "shot", "name": "h2-help" },
	{ "do": "type", "selector": ".panel.help .listbox-filter", "text": "compact" },
	{ "do": "wait", "selector": ".panel.help .listbox li.selected", "text": "/compact", "why": "the exact command ranks above other fuzzy matches" },
	{ "do": "key", "selector": ".panel.help .listbox-filter", "key": "Enter" },
	{ "do": "wait", "selector": ".panel.help", "gone": true },
	{ "do": "wait", "selector": "#input", "text": "/compact" },
	{ "do": "type", "text": "" },

	{ "do": "type", "text": "/changelog" },
	{ "do": "send" },
	{ "do": "wait", "selector": "#surface .panel.changelog .changelog-notes" },
	{ "do": "shot", "name": "h3-changelog" },
	{ "do": "key", "selector": ".panel.changelog", "key": "Escape" },
	{ "do": "wait", "selector": ".panel.changelog", "gone": true },
	{ "do": "sleep", "ms": 50, "why": "the closed command finishes before the next one" },

	{ "do": "type", "text": "/trust" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".panel.native-command:not(.closing) .panel-title", "text": "Project trust" },
	{ "do": "shot", "name": "h4-trust" },
	{ "do": "key", "selector": ".panel.native-command:not(.closing) .native-menu", "key": "Escape" },
	{ "do": "wait", "selector": ".panel.native-command", "gone": true },
	{ "do": "absent", "selector": "#toasts .toast", "text": "Saved trust decision" },

	{ "do": "paste", "uris": ["file:///tmp/a%20b.txt", "file:///tmp/c.txt"] },
	{ "do": "wait", "selector": "#input", "text": "/tmp/a b.txt\n/tmp/c.txt" },
	{ "do": "type", "text": "! ls" },
	{ "do": "paste", "uris": ["file:///tmp/a%20b.txt"] },
	{ "do": "wait", "selector": "#input", "text": "! ls '/tmp/a b.txt'" },
	{ "do": "type", "text": "look" },
	{ "do": "paste", "image": true, "why": "an attachment of the next message (qa-attachments), not a path in the text" },
	{ "do": "wait", "selector": "#attachments .attachment-thumb" },
	{ "do": "absent", "selector": "#input", "text": "pi-clipboard-" },
	{ "do": "click", "selector": "#attachments .attachment-remove" },
	{ "do": "type", "text": "" },

	{ "do": "type", "text": "/tree" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".panel.tree .tree-row", "text": "md" },
	{ "do": "shot", "name": "h5-tree" },
	{ "do": "key", "selector": ".panel.tree .listbox-filter", "key": "ArrowUp" },
	{ "do": "key", "selector": ".panel.tree .listbox-filter", "key": "Enter", "why": "Enter continues from the entry, as in the terminal" },
	{ "do": "click", "selector": ".panel.tree li", "text": "No summary" },
	{ "do": "wait", "selector": "#toasts .toast", "text": "Navigated to selected point" },
	{ "do": "absent", "selector": ".msg.assistant" },
	{ "do": "wait", "selector": "#input", "text": "md" },
	{ "do": "absent", "selector": ".panel.tree" },

	{ "do": "log", "text": "builtins2-ok" },
	{ "do": "type", "text": "/quit" },
	{ "do": "send", "why": "closes the window: drive.sh returns, the engines stop" },
	{ "do": "closes", "why": "/quit closes the window: drive.sh returns, the engines stop" }
]
