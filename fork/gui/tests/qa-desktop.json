[
	{ "do": "log", "text": "fork.11: /desktop shows the agent's desktop live, with its pointer; stop from the panel." },
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "click", "selector": ".rail-button[data-command='desktop']:not([hidden])", "why": "maintainer's QA, 2026-11-13: /desktop is an icon of the side menu while its module is on" },
	{ "do": "wait", "selector": "#surface .panel.desktop .panel-text", "text": "not running", "why": "not running: the panel says so and never starts it" },
	{ "do": "shot", "name": "d1-not-running" },
	{ "do": "type", "text": "call desktop {\"action\":\"move\",\"x\":640,\"y\":360}" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".tool[data-status='awaiting'] .dialog button", "text": "Allow once", "timeout": 30000 },
	{ "do": "sleep", "ms": 500, "why": "a question ignores clicks for 400 ms after it appears (arming)" },
	{ "do": "click", "selector": ".tool[data-status='awaiting'] .dialog button", "text": "Allow once" },
	{ "do": "wait", "selector": ".msg.assistant + .turn-summary", "timeout": 60000 },
	{ "do": "wait", "selector": "#surface .panel.desktop .desktop-frame[src]", "timeout": 15000, "why": "the panel comes alive once the agent starts its desktop" },
	{ "do": "wait", "selector": ".panel.desktop .desktop-pointer:not([hidden])", "why": "the agent's pointer, where it moved it" },
	{ "do": "sleep", "ms": 600, "why": "the pointer's move animation" },
	{ "do": "shot", "name": "d2-live" },
	{ "do": "click", "selector": ".panel.desktop .panel-actions button", "text": "Stop the desktop" },
	{ "do": "wait", "selector": ".panel.desktop .panel-text", "text": "not running", "timeout": 15000 },
	{ "do": "absent", "selector": ".panel.desktop .panel-actions button" },
	{ "do": "shot", "name": "d3-stopped" },
	{ "do": "key", "selector": ".panel.desktop", "key": "Escape" },
	{ "do": "wait", "selector": "#surface .panel.desktop", "gone": true },
	{ "do": "log", "text": "qa-desktop-ok" },
	{ "do": "quit" }
]
