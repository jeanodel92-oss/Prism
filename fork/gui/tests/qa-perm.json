[
	{ "do": "log", "text": "QA 2026-11-01: /perm as the window's own screen (modes, what is in effect, rules, scope, shortcuts)." },
	{ "do": "wait", "selector": "#composer[data-starting='false']", "timeout": 30000 },
	{ "do": "click", "selector": "#statusbar .status-chip.perm" },
	{ "do": "wait", "selector": "#surface .panel.perm .perm-mode.current[data-mode='ask']" },
	{ "do": "count", "selector": "#surface .panel.perm .perm-mode", "count": 4, "why": "the four modes, each with what it allows" },
	{ "do": "count", "selector": "#surface .panel.perm .perm-policy tbody tr", "min": 8 },
	{ "do": "shot", "name": "p1-modes" },
	{ "do": "click", "selector": ".panel.perm .perm-mode[data-mode='broad'] .perm-mode-pick" },
	{ "do": "wait", "selector": ".panel.perm .perm-mode.current[data-mode='broad']", "why": "the engine changed the mode" },
	{ "do": "wait", "selector": "#statusbar .status-chip.perm[data-mode='broad']", "why": "the footer follows" },
	{ "do": "wait", "selector": ".panel.perm .perm-keep", "text": "Broad", "why": "a mode other than the default offers to keep it" },
	{ "do": "click", "selector": ".panel.perm .segmented button", "text": "Rules" },
	{ "do": "wait", "selector": ".panel.perm .perm-rule-add" },
	{ "do": "type", "selector": ".panel.perm .perm-rule-add input", "text": "bash(echo gui-rule*)" },
	{ "do": "click", "selector": ".panel.perm .perm-rule-add button" },
	{ "do": "wait", "selector": ".panel.perm .perm-rules code", "text": "bash(echo gui-rule*)", "why": "added to this session's rules by the engine" },
	{ "do": "shot", "name": "p2-rules" },
	{ "do": "click", "selector": ".panel.perm .perm-rules li button", "text": "Remove" },
	{ "do": "wait", "selector": ".panel.perm .perm-rules code", "text": "bash(echo gui-rule*)", "gone": true },
	{ "do": "click", "selector": ".panel.perm .segmented button", "text": "In effect" },
	{ "do": "wait", "selector": ".panel.perm .perm-task-scope button", "text": "Set a task scope", "why": "the task scope is discoverable" },
	{ "do": "click", "selector": ".panel.perm .segmented button", "text": "Help and shortcuts" },
	{ "do": "wait", "selector": ".panel.perm .keys-table kbd", "why": "the mode's shortcut is shown" },
	{ "do": "wait", "selector": ".panel.perm .perm-help", "text": "/perm scope" },
	{ "do": "shot", "name": "p3-help" },
	{ "do": "click", "selector": ".panel.perm .segmented button", "text": "Modes" },
	{ "do": "click", "selector": ".panel.perm .perm-mode[data-mode='ask'] .perm-mode-pick" },
	{ "do": "wait", "selector": "#statusbar .status-chip.perm[data-mode='ask']" },
	{ "do": "key", "selector": ".panel.perm", "key": "Escape" },
	{ "do": "wait", "selector": "#surface .panel.perm", "gone": true },
	{ "do": "sleep", "ms": 50, "why": "a real key press comes after the closed command has ended; the driver's next step may not" },
	{ "do": "type", "text": "/perm scope" },
	{ "do": "send" },
	{ "do": "wait", "selector": ".panel.perm .perm-task-scope", "why": "/perm scope opens on what is in effect" },
	{ "do": "key", "selector": ".panel.perm", "key": "Escape" },
	{ "do": "wait", "selector": "#surface .panel.perm", "gone": true },
	{ "do": "log", "text": "qa-perm-ok" },
	{ "do": "quit" }
